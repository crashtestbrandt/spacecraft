<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet sources so the build resolves Godot.NET.Sdk and Klotho's runtime deps
     (LiteNetLib, Newtonsoft.Json) regardless of the machine's user-level NuGet config. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
